# Loaded automatically by Docker Compose (same directory as docker-compose.yml).
# Used as build args for collection_frontend — keep in sync with backend STAFF_* values.

NEXT_PUBLIC_RECAPTCHA_SITE_KEY=<your-recaptcha-site-key>
NEXT_PUBLIC_STAFF_API_KEY=<shared-staff-key>
NEXT_PUBLIC_STAFF_SECRET_KEY=<shared-staff-secret>
