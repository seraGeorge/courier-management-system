// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum PackageStatus {
  TO_BE_PICKED_UP
  PICKED_UP
  ADDED_TO_BAG
  LOADED_ON_TRUCK
  EN_ROUTE
  ARRIVED_AT_REGION
  SCHEDULED_FOR_DELIVERY
  OUT_FOR_DELIVERY
  DELAYED
  DELIVERED
}

enum BagStatus {
  OPEN
  SEALED
  LOADED
  IN_TRANSIT
  ARRIVED
  DELAYED
}

enum TruckStatus {
  SCHEDULED
  LOADED
  DEPARTED
  ARRIVED
  DELAYED
}

model Region {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())

  packages Package[]
}

model Package {
  id         String @id @default(uuid())
  trackingId String @unique

  senderName   String
  receiverName String

  fromAddress String
  toAddress   String

  weight Float

  status PackageStatus @default(TO_BE_PICKED_UP)

  regionCode String
  region     Region @relation(fields: [regionCode], references: [code])

  bagId String?
  bag   Bag?    @relation(fields: [bagId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusHistory PackageStatusHistory[]
}

model Bag {
  id String @id @default(uuid())

  bagNumber String @unique

  status BagStatus @default(OPEN)

  delayReason String?

  packages Package[]

  truckBags TruckBag[]

  createdAt DateTime @default(now())
}

model Truck {
  id String @id @default(uuid())

  truckNumber String @unique

  status TruckStatus @default(SCHEDULED)

  truckBags TruckBag[]

  createdAt DateTime  @default(now())
  arrivedAt DateTime?
}

model TruckBag {
  truckId String
  bagId   String

  truck Truck @relation(fields: [truckId], references: [id])
  bag   Bag   @relation(fields: [bagId], references: [id])

  loadedAt DateTime @default(now())

  @@id([truckId, bagId])
  // prevent loading same bags multiple times 
  @@unique([bagId])
}

model PackageStatusHistory {
  id String @id @default(uuid())

  packageId String

  package Package @relation(fields: [packageId], references: [id])

  status PackageStatus

  remarks String?

  createdAt DateTime @default(now())
}
