# Used by npm run setup (runs on your host after docker compose up)
LOGISTICS_URL=http://localhost:5001/api

# Stored in logistics for outbound webhooks — must use Docker service name
COLLECTION_WEBHOOK_URL=http://collection_backend:5000/api/raw-updates

# If running setup from inside a dev container on logistics_network, use:
# LOGISTICS_URL=http://logistics_backend:5001/api
